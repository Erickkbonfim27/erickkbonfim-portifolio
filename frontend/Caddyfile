# Serves the built site (dist/) on the VPS. Started by nixpacks.toml.
# Environment (set on the Easypanel service, read when Caddy starts):
#   PORT          port to listen on (Easypanel sets it; 3000 by default)
#   API_ORIGIN    the API, e.g. https://api.yourdomain.dev  (CSP connect-src + proxy target)
#   FILES_ORIGIN  where uploaded files live, e.g. https://minio.yourdomain.dev  (CSP img-src, connect-src for map layers)
{
	admin off
	auto_https off
}

:{$PORT:3000} {
	root * dist
	encode zstd gzip

	# Generated by the API from live data; served from the site's own domain so
	# agents find them at the usual place (https://yourdomain.dev/AGENTS.md).
	@agents path /AGENTS.md /llms.txt
	handle @agents {
		reverse_proxy {$API_ORIGIN:http://localhost:8000} {
			header_up Host {upstream_hostport}
		}
	}

	handle {
		# Single-page app: unknown paths render index.html, the app shows its own 404.
		try_files {path} /index.html
		file_server
	}

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' https://*.clarity.ms; style-src 'self'; font-src 'self'; img-src 'self' data: {$FILES_ORIGIN:} https://*.clarity.ms https://c.bing.com; connect-src 'self' {$API_ORIGIN:http://localhost:8000} {$FILES_ORIGIN:} https://*.clarity.ms https://c.bing.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Hashed build assets never change; everything else (index.html) must revalidate.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pages not path /assets/*
	header @pages Cache-Control "no-cache"
}
