# Copy to .env and fill in. Never commit .env.

# local | production
APP_ENV=local

# PostgreSQL (asyncpg driver). Source of truth for all content.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

# Integration tests create (and drop) a temporary database through this
# connection. The user needs the CREATEDB privilege. Point it at the
# maintenance database (usually "postgres"), never at production data.
TEST_DATABASE_ADMIN_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres

# Comma-separated origins allowed to call the API with credentials (the frontend).
CORS_ORIGINS=http://localhost:5173

# Admin session cookie
SESSION_COOKIE_NAME=ekb_session
SESSION_TTL_HOURS=12
# false only for local http development
COOKIE_SECURE=true
# e.g. .yourdomain.dev so the cookie is shared between the site and api subdomain
COOKIE_DOMAIN=

# Object storage (MinIO via Easypanel, S3 API). `make setup-storage` creates the
# bucket and makes it publicly readable but not listable.
S3_ENDPOINT_URL=https://minio.yourdomain.dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=portfolio
S3_REGION=us-east-1
# Where browsers download files from (bucket URL, no trailing slash)
PUBLIC_FILES_BASE_URL=https://minio.yourdomain.dev/portfolio

# Absolute URLs written into AGENTS.md, llms.txt and the JSON Resume
PUBLIC_SITE_URL=https://yourdomain.dev
PUBLIC_API_URL=https://api.yourdomain.dev

# Hybrid search (Qdrant). Always set an API key on a Qdrant reachable from outside.
QDRANT_URL=https://qdrant.yourdomain.dev
QDRANT_API_KEY=
QDRANT_COLLECTION=portfolio
# Dense model run in-process by fastembed (downloaded on first use, ~220 MB).
# Point the cache at a persistent volume so redeploys do not download it again.
DENSE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DENSE_DIMENSION=384
FASTEMBED_CACHE_DIR=

# At least 32 random characters: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
# Rate limit keys are HMACs of the client IP with this secret; raw IPs are never stored.
IP_HASH_SECRET=

# --- worker only (the API starts without these) ---
RABBITMQ_URL=amqp://USER:PASSWORD@HOST:5672/
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. Erick <hi@yourdomain.dev>
MAIL_FROM=
# Where new contact requests are announced
OWNER_EMAIL=
