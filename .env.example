# Copy to .env at the repository root (where `make` reads it) and fill in.
# Never commit .env. In Easypanel, the same names go in each service's
# Environment tab; the per-service extras are at the end of this file.

# local | production
APP_ENV=local

# PostgreSQL, source of truth for all content. The URL as Easypanel shows it
# (postgres://...?sslmode=disable) works: the code adapts it to the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

# Integration tests create (and drop) a temporary database through this
# connection. The user needs the CREATEDB privilege. Point it at the
# maintenance database (usually "postgres"), never at production data.
TEST_DATABASE_ADMIN_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres

# Comma-separated origins allowed to call the API with credentials: the site,
# e.g. https://yourdomain.dev. Never "*" (refused: any site could use the admin cookie).
CORS_ORIGINS=http://localhost:5173

# Admin session cookie
SESSION_COOKIE_NAME=ekb_session
SESSION_TTL_HOURS=12
# false only for local http development
COOKIE_SECURE=true
# e.g. .yourdomain.dev so the cookie is shared between the site and api subdomain
COOKIE_DOMAIN=

# Object storage on the VPS through the S3 API (MinIO or RustFS). Never keep the
# default keys (minioadmin, rustfsadmin). `make setup-storage` creates the bucket
# and makes it publicly readable but not listable.
# The public domain, not Easypanel's internal name: the S3 client rejects
# hostnames with '_' (portifolio_rustfs), and the API would refuse to start.
S3_ENDPOINT_URL=https://s3.yourdomain.dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=portfolio
S3_REGION=us-east-1
# Where browsers download files from (bucket URL, no trailing slash)
PUBLIC_FILES_BASE_URL=https://minio.yourdomain.dev/portfolio

# Absolute URLs written into AGENTS.md, llms.txt and the JSON Resume
PUBLIC_SITE_URL=https://yourdomain.dev
PUBLIC_API_URL=https://api.yourdomain.dev

# Hybrid search (Qdrant). Always set an API key on a Qdrant reachable from outside.
# Inside Easypanel, the internal name with its port: http://<project>_qdrant:6333.
# From outside, the public domain (no port means 443).
QDRANT_URL=https://qdrant.yourdomain.dev
QDRANT_API_KEY=
QDRANT_COLLECTION=portfolio
# Dense embeddings through OpenRouter (https://openrouter.ai/keys). The same key
# will serve the chat agent. Changing the model or dimension needs `make reindex`.
OPENROUTER_API_KEY=
DENSE_MODEL=openai/text-embedding-3-small
DENSE_DIMENSION=1536
# BM25 runs in-process with fastembed; its files are tiny, a cache dir is optional.
FASTEMBED_CACHE_DIR=

# At least 32 random characters: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
# Rate limit keys are HMACs of the client IP with this secret; raw IPs are never stored.
IP_HASH_SECRET=

# --- worker only (the API starts without these) ---
RABBITMQ_URL=amqp://USER:PASSWORD@HOST:5672/
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. Erick <hi@yourdomain.dev>
MAIL_FROM=
# Where new contact requests are announced
OWNER_EMAIL=

# --- Easypanel only, per service (not used by `make` locally) ---
# Worker: same build and variables as the API, plus
#   PORTFOLIO_ROLE=worker
# Site (build path /frontend):
#   VITE_API_URL=https://api.yourdomain.dev    build time, baked into the bundle
#   API_ORIGIN=https://api.yourdomain.dev      runtime, Caddy proxy and CSP
#   FILES_ORIGIN=https://files.yourdomain.dev  runtime, CSP for images
